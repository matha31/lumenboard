# Copy to .env and fill in the key. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# ── The /api path prefix matters ──────────────────────────────────────────────
# The live Lumenboard API is served under an /api prefix, NOT at the bare
# origin. Get this wrong and every single route answers 404 — including
# /health — with Vercel's own NOT_FOUND page rather than the API's
# {error:{code,message}} shape. It looks exactly like "the API isn't deployed
# yet", and the published openapi.json reinforces that impression: its own
# servers entry still reads "Production (once deployed, C-27 [HUMAN])".
#
# A missing or wrong key returns 401, never 404. So:
#   404 on /health  -> your base URL is wrong (probably missing /api)
#   401 on /health  -> base URL is right, the key is wrong or absent
LUMENBOARD_API_BASE=https://api.lumenboard.syntheticsignal.io/api

# Per-team key, issued at kickoff. Sent on x-api-key (Authorization: Bearer is
# accepted as a fallback). GET /health echoes your team name back, which is the
# quickest way to confirm it works. Never commit the real value.
LUMENBOARD_API_KEY=your-team-key-here

# ── Optional: client-side throttle (proposal §03) ─────────────────────────────
# Every call, retries and the /health preflight included, passes a limiter that
# bounds concurrency and paces request starts. Defaults shown; raise the
# interval if the shared sandbox starts rate-limiting you.
# LUMENBOARD_MAX_CONCURRENCY=4
# LUMENBOARD_MIN_INTERVAL_MS=25
